{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agentfanout/release-manifest-v1.schema.json",
  "title": "AgentFanout immutable release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "algorithm", "profile", "files", "tree_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "algorithm": {"const": "sha256"},
    "profile": {"const": "runtime"},
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "size"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "size": {"type": "integer", "minimum": 0}
        }
      }
    },
    "tree_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
