{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agentfanout/release-provenance-v1.schema.json",
  "title": "AgentFanout immutable release provenance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "installer_version",
    "tool_version",
    "release_id",
    "review_ref",
    "source_commit",
    "source_git_tree",
    "source_dirty",
    "source_dirty_paths",
    "source_tree_sha256",
    "release_tree_sha256",
    "release_manifest_sha256",
    "created_at"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "installer_version": {"const": "agentfanout-atomic-v1"},
    "tool_version": {"type": "string", "minLength": 1},
    "release_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
    "review_ref": {"type": "string", "minLength": 1},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "source_git_tree": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "source_dirty": {"type": "boolean"},
    "source_dirty_paths": {"type": "array", "items": {"type": "string"}},
    "source_tree_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "release_tree_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "release_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
