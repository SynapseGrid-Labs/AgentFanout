    }
  },
  {
    "name": "auto resets defaults",
    "prompt": "AgentFanout Auto",
    "state_json": {"provider_mode": "MiniMax", "effort_mode": "High", "fanout_policy": "automatic_guarded", "state_scope": "conversation_only"},
    "expect": {
      "command.type": "reset",
      "next_state.provider_mode": "Auto",
      "next_state.effort_mode": "Auto"
    }
  },
  {
    "name": "numeric fanout command invalid",
    "prompt": "AgentFanout Fanout 12",
    "state_json": {"provider_mode": "MiniMax", "effort_mode": "High", "fanout_policy": "automatic_guarded", "state_scope": "conversation_only"},
    "expect": {
      "command.type": "invalid",
