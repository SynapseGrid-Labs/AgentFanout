[
  {
    "name": "status is active-run only",
    "prompt": "AgentFanout Status",
    "expect": {"command.type": "status", "next_state.provider_mode": "Auto", "status.state_scope": "task_only"}
  },
  {
    "name": "help is compact",
    "prompt": "AgentFanout Help",
    "expect": {"command.type": "help", "route.worth_delegating": false},
    "expect_contains": {"command.valid_commands": "AgentFanout Codex <task>"}
  },
  {
    "name": "plain small edit is silent direct work",
    "prompt": "fix the typo in README",
    "expect": {"route.task_class": "small-edit", "route.worth_delegating": false, "dispatch.status": "main_session", "references_to_load": []}
  },
  {
    "name": "ordinary login implementation does not activate",
    "prompt": "implement a login form",
    "expect": {"route.worth_delegating": false, "dispatch.status": "main_session"}
  },
  {
    "name": "architecture question does not activate",
    "prompt": "what is multi-agent architecture?",
    "expect": {"route.worth_delegating": false, "dispatch.status": "main_session"}
  },
  {
    "name": "prior provider state cannot activate",
    "prompt": "unrelated complex request after a prior provider preference",
    "state_json": {"provider_mode": "Grok", "effort_mode": "Auto", "fanout_policy": "automatic_guarded", "state_scope": "conversation_only"},
    "expect": {"route.worth_delegating": false, "next_state.provider_mode": "Auto", "dispatch.status": "main_session"},
    "expect_contains": {"warnings": "provider_preference_ignored_task_scoped_only"}
  },
  {
    "name": "explicit Codex task is task scoped",
    "prompt": "AgentFanout Codex: review API and UI independently",
    "env": {"AGENT_FANOUT_CODEX_SUBAGENTS": "1"},
    "expect": {"command.type": "provider_task", "command.args.lifecycle": "task_scoped", "next_state.provider_mode": "Auto", "route.worth_delegating": true, "route.executor.provider": "Codex"}
  },
  {
    "name": "explicit Grok task is one shot",
    "prompt": "AgentFanout Grok: review these four modules",
    "expect": {"command.type": "provider_task", "command.args.lifecycle": "task_scoped", "next_state.provider_mode": "Auto"}
  },
  {
    "name": "explicit Local unavailability fails closed",
    "prompt": "AgentFanout Local: review three independent modules",
    "env": {"AGENT_FANOUT_LOCAL_AVAILABLE": "1"},
    "expect": {"command.type": "provider_task", "next_state.provider_mode": "Auto", "route.worth_delegating": false, "selected_provider": "main-session", "fanout.blocked": true},
    "expect_contains": {"warnings": "provider_unavailable:local:endpoint_missing"}
  },
  {
    "name": "native Codex wave is preferred for independent work",
    "prompt": "use parallel agents to inspect API, UI, database, and tests",
    "env": {"AGENT_FANOUT_CODEX_SUBAGENTS": "1"},
    "expect": {"route.worth_delegating": true, "route.executor.provider": "Codex", "fanout.planned_workers": 4}
  },
  {
    "name": "fanout research activates explicitly",
    "prompt": "fan out these independent research questions",
    "env": {"AGENT_FANOUT_CODEX_SUBAGENTS": "1"},
    "expect": {"route.worth_delegating": true, "fanout.planned_workers": 3}
  },
  {
    "name": "private tools stay in parent",
    "prompt": "send an email",
    "state_json": {"provider_mode": "Grok", "effort_mode": "Auto", "fanout_policy": "automatic_guarded", "state_scope": "conversation_only"},
    "expect": {"route.task_class": "mcp-inline", "route.worth_delegating": false, "hard_gates.requires_mcp_private_tools": true, "selected_provider": "main-session"}
  },
  {
    "name": "secrets stay in parent",
    "prompt": "debug failing auth with api key placeholder",
    "expect": {"hard_gates.requires_secrets": true, "route.worth_delegating": false, "selected_provider": "main-session"}
  },
  {
    "name": "legacy orchestrator phrase is not public activation",
    "prompt": "what is OrchestratorMode?",
    "expect": {"route.worth_delegating": false, "dispatch.status": "main_session"}
  }
]
