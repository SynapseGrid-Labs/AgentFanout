[
  {
    "name": "status default",
    "prompt": "AgentFanout Status",
    "expect": {
      "command.type": "status",
      "next_state.provider_mode": "Auto",
      "status.fanout_policy": "automatic_guarded",
      "status.startup_mode": "compact_skill_routing_only"
    }
  },
  {
    "name": "help command",
    "prompt": "AgentFanout Help",
    "expect": {
      "command.type": "help",
      "route.worth_delegating": false
    },
