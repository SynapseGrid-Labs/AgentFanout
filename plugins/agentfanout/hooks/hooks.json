{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/agentfanout_hook.py\"",
            "commandWindows": "py -3 \"%PLUGIN_ROOT%\\hooks\\agentfanout_hook.py\"",
            "timeout": 10,
            "statusMessage": "Restoring AgentFanout lease"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/agentfanout_hook.py\"",
            "commandWindows": "py -3 \"%PLUGIN_ROOT%\\hooks\\agentfanout_hook.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/agentfanout_hook.py\"",
            "commandWindows": "py -3 \"%PLUGIN_ROOT%\\hooks\\agentfanout_hook.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/agentfanout_hook.py\"",
            "commandWindows": "py -3 \"%PLUGIN_ROOT%\\hooks\\agentfanout_hook.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/agentfanout_hook.py\"",
            "commandWindows": "py -3 \"%PLUGIN_ROOT%\\hooks\\agentfanout_hook.py\"",
            "timeout": 10,
            "statusMessage": "Checking AgentFanout lease"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/agentfanout_hook.py\"",
            "commandWindows": "py -3 \"%PLUGIN_ROOT%\\hooks\\agentfanout_hook.py\"",
            "timeout": 10,
            "statusMessage": "Checking AgentFanout residual work"
          }
        ]
      }
    ]
  }
}
