{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HostedRunStateV4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "contract",
    "legacy_state",
    "transition_history"
  ],
  "properties": {
    "schema": {
      "const": "HostedRunStateV4"
    },
    "contract": {
      "$ref": "MixedRunContractV2.schema.json"
    },
    "legacy_state": {
      "$ref": "#/$defs/legacyLifecycle"
    },
    "transition_history": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "$ref": "MixedTransitionV1.schema.json"
      }
    }
  },
  "$defs": {
    "legacyLifecycle": {
      "title": "RunStateV2",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "run_id",
        "objective",
        "objective_hash",
        "status",
        "wave_index",
        "tasks",
        "budget",
        "usage",
        "no_progress_waves",
        "worker_handles",
        "launch_records",
        "result_ids",
        "host_validation_required",
        "validation_status",
        "current_wave_parent_result_tokens",
        "current_wave_completed_tasks",
        "last_wave_completed_tasks",
        "created_at",
        "updated_at",
        "history",
        "revision"
      ],
      "properties": {
        "schema": {
          "const": "RunStateV2"
        },
        "run_id": {
          "type": "string",
          "pattern": "^run_[a-f0-9]{32}$"
        },
        "project_binding": {
          "$ref": "ProjectBindingV1.schema.json"
        },
        "objective": {
          "type": "string",
          "minLength": 1
        },
        "objective_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "status": {
          "enum": [
            "planning",
            "dispatching",
            "collecting",
            "validating",
            "replanning",
            "blocked",
            "complete"
          ]
        },
        "wave_index": {
          "type": "integer",
          "minimum": 0
        },
        "current_wave_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "last_wave_task_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tasks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/legacyTask"
          }
        },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "max_wave_size",
            "max_waves",
            "max_total_workers",
            "max_total_cost_usd",
            "max_no_progress_waves",
            "max_attempts_per_task",
            "max_worker_prompt_tokens",
            "max_worker_output_tokens",
            "max_parent_result_tokens_per_wave",
            "max_result_bytes"
          ],
          "properties": {
            "max_wave_size": {
              "type": "integer",
              "minimum": 1
            },
            "max_waves": {
              "type": "integer",
              "minimum": 1
            },
            "max_total_workers": {
              "type": "integer",
              "minimum": 1
            },
            "max_total_cost_usd": {
              "type": "number",
              "minimum": 0
            },
            "max_no_progress_waves": {
              "type": "integer",
              "minimum": 1
            },
            "max_attempts_per_task": {
              "type": "integer",
              "minimum": 1
            },
            "max_worker_prompt_tokens": {
              "type": "integer",
              "minimum": 1
            },
            "max_worker_output_tokens": {
              "type": "integer",
              "minimum": 1
            },
            "max_parent_result_tokens_per_wave": {
              "type": "integer",
              "minimum": 1
            },
            "max_result_bytes": {
              "type": "integer",
              "minimum": 1024
            }
          }
        },
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "workers_launched",
            "input_tokens",
            "output_tokens",
            "parent_result_tokens",
            "cost_usd",
            "reserved_cost_usd"
          ],
          "properties": {
            "workers_launched": {
              "type": "integer",
              "minimum": 0
            },
            "input_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "output_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "parent_result_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "cost_usd": {
              "type": "number",
              "minimum": 0
            },
            "reserved_cost_usd": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "no_progress_waves": {
          "type": "integer",
          "minimum": 0
        },
        "current_wave_parent_result_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "current_wave_completed_tasks": {
          "type": "integer",
          "minimum": 0
        },
        "last_wave_completed_tasks": {
          "type": "integer",
          "minimum": 0
        },
        "worker_handles": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "launch_records": {
          "type": "object",
          "additionalProperties": {
            "type": "object"
          }
        },
        "result_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "host_validation_required": {
          "type": "boolean"
        },
        "validation_status": {
          "type": "object",
          "additionalProperties": {
            "enum": [
              "pending",
              "passed",
              "repair_required",
              "not_required"
            ]
          }
        },
        "block_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "history": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "legacyTask": {
      "title": "TaskUnitV1",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "task_id",
        "title",
        "scope",
        "input_ref",
        "task_class",
        "role",
        "status",
        "delegable",
        "dependencies",
        "allowed_paths",
        "write_set",
        "requires_path_binding",
        "requires_write_binding",
        "provider_model",
        "launch_correlation_id",
        "reasoning_effort",
        "budgets",
        "validator_required",
        "attempts"
      ],
      "properties": {
        "schema": {
          "const": "TaskUnitV1"
        },
        "task_id": {
          "type": "string",
          "pattern": "^task_[a-f0-9]{32}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "input_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "input_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "input_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "objective_excerpt": {
          "type": "string",
          "maxLength": 500
        },
        "task_class": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "role": {
          "enum": [
            "main",
            "explorer",
            "worker",
            "validator",
            "external-worker",
            "local-worker"
          ]
        },
        "status": {
          "enum": [
            "pending",
            "dispatched",
            "active",
            "completed",
            "blocked",
            "cancelled"
          ]
        },
        "delegable": {
          "type": "boolean"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "parent_task_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "allowed_paths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "write_set": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "requires_path_binding": {
          "type": "boolean"
        },
        "requires_write_binding": {
          "type": "boolean"
        },
        "provider_model": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider",
            "profile",
            "selector",
            "ack_required"
          ],
          "properties": {
            "provider": {
              "type": "string"
            },
            "profile": {
              "enum": [
                "main",
                "fast",
                "balanced",
                "frontier"
              ]
            },
            "selector": {
              "type": [
                "string",
                "null"
              ]
            },
            "requested_alias": {
              "type": [
                "string",
                "null"
              ]
            },
            "resolved_model": {
              "type": [
                "string",
                "null"
              ]
            },
            "resolved_model_source": {
              "type": "string"
            },
            "ack_required": {
              "type": "boolean"
            },
            "relative_cost": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "relative_latency": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "max_risk": {
              "type": [
                "string",
                "null"
              ]
            },
            "capabilities": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "task_classes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "reasoning_efforts": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "requires_recent_eval": {
              "type": "boolean"
            },
            "explicit_only": {
              "type": "boolean"
            },
            "forbidden_model_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "max_parallel_workers": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "required_model_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "selection_reason": {
              "type": "string"
            }
          }
        },
        "launch_correlation_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^launch_[a-f0-9]{32}$"
        },
        "reasoning_effort": {
          "enum": [
            "low",
            "medium",
            "high",
            "xhigh",
            "ultra"
          ]
        },
        "budgets": {
          "type": "object",
          "required": [
            "max_prompt_tokens",
            "max_output_tokens",
            "max_cost_usd"
          ],
          "properties": {
            "max_prompt_tokens": {
              "type": "integer",
              "minimum": 1
            },
            "max_output_tokens": {
              "type": "integer",
              "minimum": 1
            },
            "max_cost_usd": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "validator_required": {
          "type": "boolean"
        },
        "recommended_worker_handle": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^worker_[a-f0-9]{32}$"
        },
        "reserved_cost_usd": {
          "type": "number",
          "minimum": 0
        },
        "attempts": {
          "type": "integer",
          "minimum": 0
        },
        "last_error": {
          "type": [
            "string",
            "null"
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
