{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LaunchReceiptV2",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema", "run_id", "task_id", "launch_correlation_id", "provider", "provider_profile", "model_selector", "resolved_model", "reasoning_effort", "worker_handle", "started_at", "termination_token", "admission_basis"],
  "properties": {
    "schema": {"const": "LaunchReceiptV2"},
    "run_id": {"type": "string"},
    "task_id": {"type": "string"},
    "launch_correlation_id": {"type": "string"},
    "provider": {"type": "string"},
    "provider_profile": {"enum": ["fast", "balanced", "frontier"]},
    "model_selector": {"type": "string", "minLength": 1},
    "resolved_model": {"type": "string", "minLength": 1},
    "reasoning_effort": {"enum": ["low", "medium", "high", "xhigh", "ultra"]},
    "worker_handle": {"type": "string"},
    "worker_action": {"enum": ["spawn", "follow_up"]},
    "context_reused": {"type": "boolean"},
    "admission_basis": {"enum": ["explicit_provider_launch_readiness", "measured_capability"]},
    "started_at": {"type": "string", "format": "date-time"},
    "lease_expires_at": {"type": "string", "format": "date-time"},
    "heartbeat_interval_seconds": {"type": "integer", "minimum": 1, "maximum": 900},
    "termination_token": {"type": "string", "minLength": 16, "maxLength": 512},
    "tool_policy_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "capability_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "host_manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "project_binding_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "input_mode": {"type": "string"},
    "tool_mode": {"type": "string"},
    "adapter_identity": {"type": "object"},
    "local_attestation": {"$ref": "LocalLaunchAttestationV2.schema.json"},
    "sandbox_receipt": {"$ref": "SandboxReceiptV1.schema.json"},
    "local_capability_attestation": {"$ref": "LocalCapabilityAttestationV1.schema.json"},
    "local_bridge_observation": {"type": "object"},
    "local_no_tool_boundary": {"$ref": "LocalNoToolBoundaryV1.schema.json"},
    "coordinator_hosted_boundary": {"$ref": "CoordinatorHostedBoundaryV1.schema.json"}
  }
}
