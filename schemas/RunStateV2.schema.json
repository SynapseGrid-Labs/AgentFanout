{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synapsegrid-labs.example/schemas/agentfanout/RunStateV2.schema.json",
  "title": "RunStateV2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "run_id", "objective", "objective_hash", "status", "wave_index",
    "tasks", "budget", "usage", "no_progress_waves", "worker_handles", "launch_records",
    "result_ids", "host_validation_required", "validation_status", "current_wave_parent_result_tokens", "current_wave_completed_tasks",
    "last_wave_completed_tasks", "created_at", "updated_at", "history", "revision"
  ],
  "properties": {
    "schema": {"const": "RunStateV2"},
    "run_id": {"type": "string", "pattern": "^run_[a-f0-9]{32}$"},
    "project_binding": {"$ref": "ProjectBindingV1.schema.json"},
    "objective": {"type": "string", "minLength": 1},
    "objective_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "status": {"enum": ["planning", "dispatching", "collecting", "validating", "replanning", "blocked", "complete"]},
    "wave_index": {"type": "integer", "minimum": 0},
    "current_wave_id": {"type": ["string", "null"]},
    "last_wave_task_ids": {"type": "array", "items": {"type": "string"}},
    "tasks": {"type": "array", "minItems": 1, "items": {"$ref": "TaskUnitV1.schema.json"}},
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_wave_size", "max_waves", "max_total_workers", "max_total_cost_usd",
        "max_no_progress_waves", "max_attempts_per_task", "max_worker_prompt_tokens",
        "max_worker_output_tokens", "max_parent_result_tokens_per_wave", "max_result_bytes"
      ],
      "properties": {
        "max_wave_size": {"type": "integer", "minimum": 1},
        "max_waves": {"type": "integer", "minimum": 1},
        "max_total_workers": {"type": "integer", "minimum": 1},
        "max_total_cost_usd": {"type": "number", "minimum": 0},
        "max_no_progress_waves": {"type": "integer", "minimum": 1},
        "max_attempts_per_task": {"type": "integer", "minimum": 1},
        "max_worker_prompt_tokens": {"type": "integer", "minimum": 1},
        "max_worker_output_tokens": {"type": "integer", "minimum": 1},
        "max_parent_result_tokens_per_wave": {"type": "integer", "minimum": 1},
        "max_result_bytes": {"type": "integer", "minimum": 1024}
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workers_launched", "input_tokens", "output_tokens", "parent_result_tokens", "cost_usd", "reserved_cost_usd"],
      "properties": {
        "workers_launched": {"type": "integer", "minimum": 0},
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "parent_result_tokens": {"type": "integer", "minimum": 0},
        "cost_usd": {"type": "number", "minimum": 0},
        "reserved_cost_usd": {"type": "number", "minimum": 0}
      }
    },
    "no_progress_waves": {"type": "integer", "minimum": 0},
    "current_wave_parent_result_tokens": {"type": "integer", "minimum": 0},
    "current_wave_completed_tasks": {"type": "integer", "minimum": 0},
    "last_wave_completed_tasks": {"type": "integer", "minimum": 0},
    "worker_handles": {"type": "object", "additionalProperties": {"type": "string"}},
    "launch_records": {"type": "object", "additionalProperties": {"type": "object"}},
    "result_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "host_validation_required": {"type": "boolean"},
    "validation_status": {
      "type": "object",
      "additionalProperties": {"enum": ["pending", "passed", "repair_required", "not_required"]}
    },
    "block_reason": {"type": ["string", "null"]},
    "history": {"type": "array", "items": {"type": "object"}},
    "revision": {"type": "integer", "minimum": 0}
  }
}
