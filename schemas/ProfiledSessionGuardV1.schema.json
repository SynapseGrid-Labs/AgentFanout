{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProfiledSessionGuardV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run_id",
    "contract_sha256",
    "runtime_sha256",
    "state_path_sha256",
    "host_destination",
    "parent_destination"
  ],
  "properties": {
    "schema": {
      "const": "ProfiledSessionGuardV1"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
    },
    "contract_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "runtime_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "state_path_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "host_destination": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
    },
    "parent_destination": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
    }
  }
}
