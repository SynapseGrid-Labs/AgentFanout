{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GrokCLIWireUsageV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "model_id",
    "provider_prompt_id",
    "input_tokens",
    "output_tokens",
    "cached_read_tokens",
    "cache_creation_tokens",
    "noncached_noncreation_input_tokens",
    "reasoning_tokens",
    "model_calls",
    "num_turns",
    "api_duration_ms",
    "cost_usd_ticks",
    "cost_is_partial",
    "cumulative",
    "provider_cost_authority",
    "mapping_sha256"
  ],
  "properties": {
    "schema": {
      "const": "GrokCLIWireUsageV1"
    },
    "model_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "provider_prompt_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "input_tokens": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "output_tokens": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "cached_read_tokens": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "cache_creation_tokens": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "noncached_noncreation_input_tokens": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "reasoning_tokens": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "model_calls": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "num_turns": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "api_duration_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "cost_usd_ticks": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "cost_is_partial": {
      "type": "boolean"
    },
    "cumulative": {
      "type": "boolean"
    },
    "provider_cost_authority": {
      "const": "unverified_marginal_charge"
    },
    "mapping_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
