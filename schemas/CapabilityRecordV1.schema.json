{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CapabilityRecordV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "provider", "exact_model_id", "reasoning_effort", "task_class", "tool_policy_sha256", "evaluation_version", "evidence_class", "quality_confidence", "sample_size", "p50_latency_ms", "p95_latency_ms", "failure_rate", "validator_failure_rate", "context_window", "price_card_version", "observed_at", "expires_at", "status"],
  "properties": {
    "schema": {"const": "CapabilityRecordV1"},
    "provider": {"type": "string"},
    "exact_model_id": {"type": "string"},
    "reasoning_effort": {"enum": ["low", "medium", "high", "xhigh", "ultra"]},
    "task_class": {"type": "string"},
    "tool_policy_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "evaluation_version": {"type": "string"},
    "evidence_class": {"enum": ["measured_capability", "launch_readiness"]},
    "host_manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "project_binding_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "adapter_id": {"type": "string"},
    "adapter_version": {"type": "string"},
    "executable_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "adapter_identity": {"type": "object"},
    "quality_confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "sample_size": {"type": "integer", "minimum": 0},
    "p50_latency_ms": {"type": "number", "minimum": 0},
    "p95_latency_ms": {"type": "number", "minimum": 0},
    "failure_rate": {"type": "number", "minimum": 0, "maximum": 1},
    "validator_failure_rate": {"type": "number", "minimum": 0, "maximum": 1},
    "context_window": {"type": "integer", "minimum": 1},
    "price_card_version": {"type": "string"},
    "observed_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["approved", "quarantined", "expired"]}
  }
}
