{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synapsegrid-labs.example/schemas/agentfanout/LocalCapabilityAttestationV1.schema.json",
  "title": "LocalCapabilityAttestationV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "attestation_id", "source", "issuer", "selector_alias",
    "exact_model_id", "observed_at", "expires_at", "active_mode",
    "context_window", "evaluated_task_classes", "supported_reasoning_efforts",
    "max_risk", "tools", "supports_file_editing"
  ],
  "properties": {
    "schema": {"const": "LocalCapabilityAttestationV1"},
    "attestation_id": {"type": "string", "pattern": "^localcap_[a-f0-9]{32}$"},
    "source": {"const": "host"},
    "issuer": {"const": "host-runtime"},
    "selector_alias": {"type": "string", "minLength": 1, "maxLength": 200},
    "exact_model_id": {"type": "string", "minLength": 1, "maxLength": 500},
    "observed_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "active_mode": {"type": "string", "minLength": 1, "maxLength": 200},
    "context_window": {"type": "integer", "minimum": 1},
    "evaluated_task_classes": {
      "type": "array", "minItems": 1, "maxItems": 64,
      "items": {"type": "string", "minLength": 1, "maxLength": 100}, "uniqueItems": true
    },
    "supported_reasoning_efforts": {
      "type": "array", "minItems": 1, "maxItems": 5,
      "items": {"enum": ["low", "medium", "high", "xhigh", "ultra"]}, "uniqueItems": true
    },
    "max_risk": {"enum": ["low", "medium", "high", "critical"]},
    "tools": {
      "type": "array", "minItems": 0, "maxItems": 64,
      "items": {"type": "string", "minLength": 1, "maxLength": 100}, "uniqueItems": true
    },
    "supports_file_editing": {"type": "boolean"}
  }
}
